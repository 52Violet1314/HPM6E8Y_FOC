{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "C:/ST/STM32CubeCLT_1.19.0/CMake/bin/cmake.exe",
            "args": ["--build", "${workspaceFolder}/build"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "flash (OpenOCD + FT2232)",
            "type": "shell",
            "command": "D:/sdk_env/tools/openocd/openocd.exe",
            "args": [
                "-f", "${workspaceFolder}/openocd.cfg",
                "-c", "program ${workspaceFolder}/build/output/demo.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": ["build"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}
