# ---- 构建产物（仅本工程，SDK 目录不作过滤，保证可克隆即编译）----
/build/
/cmake-build-*/
/Debug/
/Release/
/*.elf
/*.bin
/*.hex
/*.map
/*.lst
/*.o
/*.d
/*.a

# ---- IDE ----
.idea/
*.uvprojx
*.uvoptx
*.ewp
*.eww
*.dep
.segger_project.json

# ---- 编辑器/系统 ----
.DS_Store
Thumbs.db
*.swp
*~
__pycache__/
*.pyc

# ---- 本地化备份 ----
/CMakeLists.txt.localized.bak

# ---- 排障临时区 ----
# tmp/ 里放的是: ninja 构建日志、OpenOCD 脚本、上位机仿真脚本、
# 从 flash dump 出来的共享内存二进制、以及整包固件的备份。
# 全是"当时那一次排查"的产物, 对复现没有价值, 不进仓库。
# 真正要留的工具请放 tools/。
/tmp/

# 上面 tmp/ 里如果有确实想留的东西, 用 ! 单独放行, 例如:
# !/tmp/某个要留的文件

# ---- 根目录散落的一次性输出（烧写 / OpenOCD / ninja 日志）----
# 和 tmp/ 同一性质: "当时那一次"的产物, 不进仓库。
# 有结论请写进 docs/reports/ 或 docs/design/, 原始 log 留在本地即可。
/flash_*.txt
/flash_*.log
/ocd_*.txt
/ninja_*.log
/*.log

# ---- clangd / 语言服务器缓存 ----
/.cache/
